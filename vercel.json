{
  "crons": [
    {
      "path": "/api/track-orders",
      "schedule": "0 18 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/push-config", "destination": "/api/push?action=config" },
    { "source": "/api/push-subscribe", "destination": "/api/push?action=subscribe" },
    { "source": "/api/ship-order", "destination": "/api/shipping?mode=single" },
    { "source": "/api/ship-orders-bulk", "destination": "/api/shipping?mode=bulk" },
    { "source": "/p/zikr-kids", "destination": "/p/product.html?slug=zikr-kids" },
    { "source": "/p/barber-shop", "destination": "/p/barber-shop.html" },
    { "source": "/p/:slug", "destination": "/p/product.html?slug=:slug" },
    { "source": "/c/:slug", "destination": "/c/collection.html?slug=:slug" },
    { "source": "/shipping", "destination": "/shipping.html" },
    { "source": "/returns", "destination": "/returns.html" },
    { "source": "/terms", "destination": "/terms.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/meta-pixel.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/tiktok-pixel.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/cart.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/admin.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/operator.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
